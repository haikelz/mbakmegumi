---
import "@/styles/global.css";
import "@fontsource/geist-mono";
import "@fontsource/geist-sans";

interface Props {
  title: string;
  description: string;
  url: string;
}

const { title, description, url } = Astro.props;

const ogImagePath = "/banner.png";
const ogImageUrl = `${url}${ogImagePath}`;
const ogImageDimensions = { width: 736, height: 414 };
const ogImageAlt = "Mbak Megumi — Katou Megumi tribute site";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Haikel" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={url} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageDimensions.width)} />
    <meta property="og:image:height" content={String(ogImageDimensions.height)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Mbak Megumi" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href={ogImagePath} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Structured Data: WebSite + ProfilePage + Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "name": "Mbak Megumi",
          "url": url,
          "description": description,
          "inLanguage": "en",
        },
        {
          "@type": "ProfilePage",
          "url": url,
          "name": title,
          "description": description,
          "about": {
            "@type": "Person",
            "name": "Megumi Kato",
            "alternateName": "Katou Megumi",
            "description": "The quiet heroine from Saenai Heroine no Sodatekata — an ordinary girl whose presence slowly becomes unforgettable.",
            "image": `${url}/assets/katou-2.jpg`,
          },
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": ogImageUrl,
            "width": String(ogImageDimensions.width),
            "height": String(ogImageDimensions.height),
          },
        },
      ],
    })}>
    </script>

    <script is:inline>
      const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const applyTheme = () => {
        const stored = localStorage.getItem("theme");
        const theme = stored === "light" || stored === "dark" || stored === "system" ? stored : "system";
        const isDark = theme === "dark" || (theme === "system" && mediaQuery.matches);
        document.documentElement.classList.toggle("dark", isDark);
      };
      applyTheme();
      mediaQuery.addEventListener("change", applyTheme);
    </script>
  </head>
  <body>
    <div class="page-bg-grid" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to the story</a>
    <slot />
  </body>
</html>
